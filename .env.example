# Copy to .env for local development. Never commit .env.
# These values are for a throwaway local stack only.

# Generate your own: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=dev-only-insecure-key-replace-me-0123456789abcdefghijklmnop

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=taskmanager
POSTGRES_USER=taskmanager
POSTGRES_PASSWORD=taskmanager

REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Mailpit catches every email; its web UI is on http://localhost:8025
EMAIL_HOST=localhost
EMAIL_PORT=1025
# When the overdue digest runs (5-field cron, UTC). Read by Celery beat.
OVERDUE_DIGEST_CRON=0 8 * * *
